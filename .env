import streamlit as st
import random

# ---------------------------------------------------------
# PAGE CONFIG
# ---------------------------------------------------------
st.set_page_config(
    page_title="Language Buddy",
    page_icon="🌐",
    layout="wide",
    initial_sidebar_state="collapsed"
)

# ---------------------------------------------------------
# CUSTOM CSS
# ---------------------------------------------------------
st.markdown("""
<style>

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

* {
    font-family: 'Inter', sans-serif;
}

.stApp {
    background: #f7f8fc;
}

header {
    visibility: hidden;
}

.block-container {
    padding: 0 5% 40px 5%;
    max-width: 1400px;
}

/* NAVBAR */

.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 0;
}

.logo {
    font-size: 27px;
    font-weight: 800;
    color: #4f46e5;
}

.logo span {
    color: #111827;
}

.nav-links {
    display: flex;
    gap: 28px;
    align-items: center;
}

.nav-item {
    color: #4b5563;
    font-size: 15px;
    font-weight: 600;
}

/* HERO */

.hero {
    background: linear-gradient(135deg, #eef2ff, #ffffff);
    border-radius: 28px;
    padding: 70px 60px;
    margin-top: 20px;
    overflow: hidden;
}

.hero-title {
    font-size: 55px;
    line-height: 1.08;
    font-weight: 800;
    color: #111827;
    margin-bottom: 20px;
}

.hero-title span {
    color: #4f46e5;
}

.hero-text {
    font-size: 18px;
    color: #6b7280;
    max-width: 650px;
    line-height: 1.7;
}

/* CARDS */

.card {
    background: white;
    border-radius: 20px;
    padding: 25px;
    border: 1px solid #e5e7eb;
    box-shadow: 0 8px 30px rgba(0,0,0,0.04);
    margin-bottom: 20px;
}

.card-title {
    font-size: 20px;
    font-weight: 700;
    color: #111827;
}

.card-text {
    color: #6b7280;
    line-height: 1.6;
}

/* DASHBOARD */

.dashboard-title {
    font-size: 38px;
    font-weight: 800;
    color: #111827;
}

.stat {
    background: white;
    border-radius: 18px;
    padding: 24px;
    border: 1px solid #e5e7eb;
}

.stat-number {
    font-size: 32px;
    font-weight: 800;
    color: #4f46e5;
}

.stat-label {
    color: #6b7280;
}

/* CHAT */

.chat-user {
    background: #4f46e5;
    color: white;
    padding: 14px 18px;
    border-radius: 18px 18px 4px 18px;
    margin: 10px 0 10px auto;
    max-width: 70%;
}

.chat-ai {
    background: #eef2ff;
    color: #1f2937;
    padding: 14px 18px;
    border-radius: 18px 18px 18px 4px;
    margin: 10px 0;
    max-width: 70%;
}

/* FOOTER */

.footer {
    text-align: center;
    color: #9ca3af;
    padding: 50px 0 20px;
}

/* MOBILE */

@media(max-width: 768px) {
    .hero {
        padding: 40px 25px;
    }

    .hero-title {
        font-size: 38px;
    }

    .nav-links {
        display: none;
    }
}

</style>
""", unsafe_allow_html=True)


# ---------------------------------------------------------
# SESSION STATE
# ---------------------------------------------------------

if "page" not in st.session_state:
    st.session_state.page = "Home"

if "logged_in" not in st.session_state:
    st.session_state.logged_in = False

if "username" not in st.session_state:
    st.session_state.username = "Learner"

if "messages" not in st.session_state:
    st.session_state.messages = []


# ---------------------------------------------------------
# NAVIGATION
# ---------------------------------------------------------

def go_to(page):
    st.session_state.page = page


# ---------------------------------------------------------
# NAVBAR
# ---------------------------------------------------------

st.markdown("""
<div class="navbar">

<div class="logo">
🌐 Language<span>Buddy</span>
</div>

<div class="nav-links">
<div class="nav-item">Learn</div>
<div class="nav-item">Practice</div>
<div class="nav-item">Progress</div>
</div>

</div>
""", unsafe_allow_html=True)


# ---------------------------------------------------------
# HOME PAGE
# ---------------------------------------------------------

if st.session_state.page == "Home":

    st.markdown("""
    <div class="hero">

    <div class="hero-title">
    Learn Languages.<br>
    <span>Speak With Confidence.</span>
    </div>

    <div class="hero-text">
    Language Buddy is your AI-powered language learning companion.
    Practice conversations, improve vocabulary, develop speaking skills,
    and track your progress in one simple platform.
    </div>

    </div>
    """, unsafe_allow_html=True)

    st.write("")

    col1, col2, col3 = st.columns(3)

    with col1:
        st.markdown("""
        <div class="card">
        <div style="font-size:35px;">💬</div>
        <div class="card-title">AI Conversation</div>
        <div class="card-text">
        Practice realistic conversations and improve your communication skills.
        </div>
        </div>
        """, unsafe_allow_html=True)

    with col2:
        st.markdown("""
        <div class="card">
        <div style="font-size:35px;">📚</div>
        <div class="card-title">Smart Vocabulary</div>
        <div class="card-text">
        Learn useful words and phrases through simple examples and practice.
        </div>
        </div>
        """, unsafe_allow_html=True)

    with col3:
        st.markdown("""
        <div class="card">
        <div style="font-size:35px;">🎤</div>
        <div class="card-title">Speaking Practice</div>
        <div class="card-text">
        Improve your speaking confidence with guided practice activities.
        </div>
        </div>
        """, unsafe_allow_html=True)

    st.write("")

    c1, c2, c3 = st.columns([1, 1, 1])

    with c1:
        if st.button("🚀 Start Learning", use_container_width=True):
            go_to("Sign Up")
            st.rerun()

    with c2:
        if st.button("🔐 Sign In", use_container_width=True):
            go_to("Sign In")
            st.rerun()

    with c3:
        if st.button("📊 Demo Dashboard", use_container_width=True):
            st.session_state.logged_in = True
            go_to("Dashboard")
            st.rerun()


# ---------------------------------------------------------
# SIGN UP
# ---------------------------------------------------------

elif st.session_state.page == "Sign Up":

    st.markdown(
        "<div class='dashboard-title'>Create your Language Buddy account</div>",
        unsafe_allow_html=True
    )

    st.write("")

    col1, col2 = st.columns([1, 1])

    with col1:

        name = st.text_input("Full Name")
        email = st.text_input("Email")
        password = st.text_input("Password", type="password")

        language = st.selectbox(
            "Choose a language to learn",
            ["English", "Telugu", "Hindi", "Spanish", "French", "German"]
        )

        if st.button("Create Account", use_container_width=True):

            if name and email and password:

                st.session_state.username = name
                st.session_state.logged_in = True
                st.session_state.page = "Dashboard"

                st.success("Account created successfully!")
                st.rerun()

            else:
                st.warning("Please fill all fields.")

    if st.button("Already have an account? Sign In"):
        go_to("Sign In")
        st.rerun()


# ---------------------------------------------------------
# SIGN IN
# ---------------------------------------------------------

elif st.session_state.page == "Sign In":

    st.markdown(
        "<div class='dashboard-title'>Welcome Back 👋</div>",
        unsafe_allow_html=True
    )

    st.write("")

    email = st.text_input("Email")
    password = st.text_input("Password", type="password")

    if st.button("Sign In", use_container_width=True):

        if email and password:

            st.session_state.logged_in = True
            st.session_state.username = email.split("@")[0]
            st.session_state.page = "Dashboard"

            st.success("Login successful!")
            st.rerun()

        else:
            st.warning("Enter email and password.")

    if st.button("Create New Account"):
        go_to("Sign Up")
        st.rerun()


# ---------------------------------------------------------
# DASHBOARD
# ---------------------------------------------------------

elif st.session_state.page == "Dashboard":

    st.markdown(
        f"<div class='dashboard-title'>Hello, {st.session_state.username} 👋</div>",
        unsafe_allow_html=True
    )

    st.write("Continue your language learning journey.")

    c1, c2, c3, c4 = st.columns(4)

    with c1:
        st.markdown("""
        <div class="stat">
        <div class="stat-number">72%</div>
        <div class="stat-label">Overall Progress</div>
        </div>
        """, unsafe_allow_html=True)

    with c2:
        st.markdown("""
        <div class="stat">
        <div class="stat-number">245</div>
        <div class="stat-label">Words Learned</div>
        </div>
        """, unsafe_allow_html=True)

    with c3:
        st.markdown("""
        <div class="stat">
        <div class="stat-number">18</div>
        <div class="stat-label">Practice Sessions</div>
        </div>
        """, unsafe_allow_html=True)

    with c4:
        st.markdown("""
        <div class="stat">
        <div class="stat-number">7 🔥</div>
        <div class="stat-label">Day Streak</div>
        </div>
        """, unsafe_allow_html=True)

    st.write("")

    col1, col2 = st.columns(2)

    with col1:

        st.markdown("""
        <div class="card">
        <div class="card-title">💬 AI Conversation</div>
        <div class="card-text">
        Practice conversations with your AI Language Buddy.
        </div>
        </div>
        """, unsafe_allow_html=True)

        if st.button("Start Conversation", use_container_width=True):
            go_to("Conversation")
            st.rerun()

    with col2:

        st.markdown("""
        <div class="card">
        <div class="card-title">📚 Vocabulary</div>
        <div class="card-text">
        Learn and practice new words every day.
        </div>
        </div>
        """, unsafe_allow_html=True)

        if st.button("Learn Vocabulary", use_container_width=True):
            go_to("Vocabulary")
            st.rerun()

    st.write("")

    if st.button("🎤 Speaking Practice", use_container_width=True):
        go_to("Speaking")
        st.rerun()

    if st.button("⚙️ Admin Dashboard", use_container_width=True):
        go_to("Admin")
        st.rerun()


# ---------------------------------------------------------
# AI CONVERSATION
# ---------------------------------------------------------

elif st.session_state.page == "Conversation":

    st.markdown(
        "<div class='dashboard-title'>💬 AI Conversation</div>",
        unsafe_allow_html=True
    )

    st.write("Practice English with your Language Buddy.")

    if not st.session_state.messages:

        st.session_state.messages.append(
            ("ai", "Hello! 👋 I'm your Language Buddy. How was your day?")
        )

    for sender, message in st.session_state.messages:

        if sender == "user":

            st.markdown(
                f"<div class='chat-user'>{message}</div>",
                unsafe_allow_html=True
            )

        else:

            st.markdown(
                f"<div class='chat-ai'>🤖 {message}</div>",
                unsafe_allow_html=True
            )

    user_message = st.chat_input("Type your message...")

    if user_message:

        st.session_state.messages.append(("user", user_message))

        responses = [
            "That's interesting! Can you tell me more?",
            "Great! Your sentence is understandable. Keep practicing!",
            "Nice! Try using another sentence with that word.",
            "Good job! You're improving your communication skills.",
            "Excellent! Let's continue our conversation."
        ]

        response = random.choice(responses)

        st.session_state.messages.append(("ai", response))

        st.rerun()

    if st.button("⬅ Back to Dashboard"):
        go_to("Dashboard")
        st.rerun()


# ---------------------------------------------------------
# VOCABULARY
# ---------------------------------------------------------

elif st.session_state.page == "Vocabulary":

    st.markdown(
        "<div class='dashboard-title'>📚 Vocabulary Builder</div>",
        unsafe_allow_html=True
    )

    words = [
        ("Confident", "Feeling sure about yourself"),
        ("Improve", "To become better"),
        ("Communication", "The process of sharing information"),
        ("Practice", "Doing something repeatedly to improve"),
        ("Fluent", "Able to speak smoothly and easily")
    ]

    for word, meaning in words:

        st.markdown(
            f"""
            <div class="card">
            <div class="card-title">{word}</div>
            <div class="card-text">{meaning}</div>
            </div>
            """,
            unsafe_allow_html=True
        )

    if st.button("⬅ Back to Dashboard"):
        go_to("Dashboard")
        st.rerun()


# ---------------------------------------------------------
# SPEAKING
# ---------------------------------------------------------

elif st.session_state.page == "Speaking":

    st.markdown(
        "<div class='dashboard-title'>🎤 Speaking Practice</div>",
        unsafe_allow_html=True
    )

    st.markdown("""
    <div class="card">

    <div class="card-title">
    Practice Sentence
    </div>

    <br>

    <div style="font-size:22px;">
    "I am learning English because I want to communicate confidently."
    </div>

    <br>

    <div class="card-text">
    Read the sentence aloud and practice your pronunciation.
    </div>

    </div>
    """, unsafe_allow_html=True)

    audio = st.audio_input("Record your voice")

    if audio:
        st.audio(audio)
        st.success("Voice recorded successfully! 🎉")

    if st.button("⬅ Back to Dashboard"):
        go_to("Dashboard")
        st.rerun()


# ---------------------------------------------------------
# ADMIN DASHBOARD
# ---------------------------------------------------------

elif st.session_state.page == "Admin":

    st.markdown(
        "<div class='dashboard-title'>👨‍💼 Admin Dashboard</div>",
        unsafe_allow_html=True
    )

    st.write("Monitor Language Buddy learning activity.")

    c1, c2, c3 = st.columns(3)

    with c1:
        st.markdown("""
        <div class="stat">
        <div class="stat-number">1,245</div>
        <div class="stat-label">Total Users</div>
        </div>
        """, unsafe_allow_html=True)

    with c2:
        st.markdown("""
        <div class="stat">
        <div class="stat-number">856</div>
        <div class="stat-label">Active Learners</div>
        </div>
        """, unsafe_allow_html=True)

    with c3:
        st.markdown("""
        <div class="stat">
        <div class="stat-number">12,480</div>
        <div class="stat-label">Practice Sessions</div>
        </div>
        """, unsafe_allow_html=True)

    st.write("")

    st.markdown("""
    <div class="card">

    <div class="card-title">
    Recent Activity
    </div>

    <br>

    👤 User completed vocabulary lesson<br><br>
    🎤 User completed speaking practice<br><br>
    💬 User completed AI conversation<br><br>
    📚 User learned 20 new words

    </div>
    """, unsafe_allow_html=True)

    if st.button("⬅ Back to Dashboard"):
        go_to("Dashboard")
        st.rerun()


# ---------------------------------------------------------
# FOOTER
# ---------------------------------------------------------

st.markdown("""
<div class="footer">
🌐 Language Buddy · Learn · Practice · Communicate
</div>
""", unsafe_allow_html=True)